# Git files
.git
.gitignore

# Logs and temp files
logs/
models/
*.gguf

# Python cache and build artifacts
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# Docker-related (exclude compose/env to avoid baking secrets, but they're mounted as volumes anyway)
compose.yaml
.env
Dockerfile.server

# Test scripts and utilities (not needed in image)
scripts/
monitor.py
LOCUST_llama-server_docker_inf.py

# Documentation (not needed in image)
docs/
README.md
Benchmark.md
LLM-SERVICE.md
*.md

# Project configuration files (not needed in image)
pyproject.toml
requirements.txt
uv.lock

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Other common exclusions
node_modules/
.venv/
*.bak
.DS_Store
Thumbs.db
